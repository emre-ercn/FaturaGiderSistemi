@model FaturaGiderSistemi.Models.Fatura
@{
    ViewData["Title"] = "Yeni Fatura Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0 fw-bold">Yeni Fatura Girişi</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">

                        <!-- Fatura & Fiş No -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FaturaNo" class="form-label fw-bold"></label>
                                <input asp-for="FaturaNo" class="form-control" placeholder="Örn: FAT-2026-001" />
                                <span asp-validation-for="FaturaNo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FisNo" class="form-label fw-bold"></label>
                                <input asp-for="FisNo" class="form-control" placeholder="Fiş numarasını girin" />
                            </div>
                        </div>

                        <!-- Tutar & KDV Hesaplamaları -->
                        <div class="row bg-light p-3 rounded mb-3 border">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label asp-for="Tutar" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <input asp-for="Tutar" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">₺</span>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label asp-for="KdvOrani" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">%</span>
                                    <input asp-for="KdvOrani" type="number" class="form-control" value="20" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ToplamTutar" class="form-label fw-bold text-primary"></label>
                                <div class="input-group">
                                    <input asp-for="ToplamTutar" type="number" step="0.01" class="form-control border-primary" />
                                    <span class="input-group-text bg-primary text-white">₺</span>
                                </div>
                            </div>
                        </div>

                        <!-- Tarih & Durum -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Tarih" class="form-label fw-bold"></label>
                                <input asp-for="Tarih" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Durum" class="form-label fw-bold"></label>
                                <select asp-for="Durum" class="form-select">
                                    <option value="true">Ödendi (Tahsil Edildi)</option>
                                    <option value="false">Bekliyor (Açık Fatura)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Yabancı Anahtarlar (Dropdown) -->
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="SirketId" class="form-label fw-bold"></label>
                                <select asp-for="SirketId" class="form-select" asp-items="ViewBag.Sirketler">
                                    <option value="">-- Şirket Seçiniz --</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="KullaniciId" class="form-label fw-bold"></label>
                                <select asp-for="KullaniciId" class="form-select" asp-items="ViewBag.Kullanicilar">
                                    <option value="">-- İşlemi Yapan Kullanıcı --</option>
                                </select>
                            </div>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-end border-top pt-3">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary me-2 px-4">İptal</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>