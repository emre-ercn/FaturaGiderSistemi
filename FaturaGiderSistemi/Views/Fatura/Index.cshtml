@model IEnumerable<FaturaGiderSistemi.Models.Fatura>
@{
    ViewData["Title"] = "Faturalar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Kayıtlı Faturalar</h3>
        <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            + Yeni Fatura Ekle
        </a>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Fatura No</th>
                        <th>Şirket</th>
                        <th>Toplam Tutar</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-bold">@item.FaturaNo</span></td>
                            <td>@(item.Sirket != null ? item.Sirket.Ad : "Bilinmiyor")</td>
                            <td>@item.ToplamTutar.ToString("N2") ₺</td>
                            <td>@item.Tarih.ToShortDateString()</td>
                            <td>
                                @if (item.Durum)
                                {
                                    <span class="badge bg-success">Ödendi</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Bekliyor</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center m-3">
                    Henüz sisteme eklenmiş bir fatura bulunmuyor.
                </div>
            }
        </div>
    </div>
</div>