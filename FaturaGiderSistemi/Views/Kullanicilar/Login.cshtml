@model FaturaGiderSistemi.Models.Kullanici
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sisteme Giriş - Fatura Yönetimi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow-lg border-0" style="width: 25rem;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Yönetim Paneli</h3>
                <p class="text-muted">Lütfen yetkili bilgilerinizi giriniz</p>
            </div>

            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Hata</div>
            }

            <form asp-action="Login" asp-controller="Kullanici" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Adınız</label>
                    <input type="text" asp-for="Ad" class="form-control form-control-lg" placeholder="Adınızı girin" required />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Şifre</label>
                    <input type="password" asp-for="Sifre" class="form-control form-control-lg" placeholder="Şifrenizi girin" required />
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Giriş Yap</button>
            </form>
        </div>
    </div>

</body>
</html>