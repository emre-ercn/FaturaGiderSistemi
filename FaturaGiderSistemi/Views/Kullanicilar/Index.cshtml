@model IEnumerable<FaturaGiderSistemi.Models.Sirket>
@{
    ViewData["Title"] = "Şirketler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Şirket Listesi</h2>
        <a asp-action="Create" class="btn btn-primary fw-bold">+ Yeni Şirket Ekle</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="p-3">Şirket Adı</th>
                        <th class="p-3 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="p-3 align-middle">@item.Ad</td>
                            <td class="p-3 text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bu şirketi silmek istediğinize emin misiniz?');">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>