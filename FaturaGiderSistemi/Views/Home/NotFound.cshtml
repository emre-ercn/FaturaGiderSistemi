@{
    ViewData["Title"] = "Sayfa Bulunamadı";
}

<div class="container text-center mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="display-1 fw-bold text-danger"><i class="bi bi-exclamation-triangle"></i> 404</h1>
            <h2 class="mb-4">Oops! Aradığınız Sayfa Bulunamadı.</h2>
            <p class="lead opacity-75 mb-5">
                Girmeye çalıştığınız fatura veya sayfa silinmiş, adı değiştirilmiş veya geçici olarak ulaşılamıyor olabilir.
                Sistemin karanlık dehlizlerinde kaybolmayın!
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                <i class="bi bi-house-door"></i> Ana Sayfaya Dön
            </a>
        </div>
    </div>
</div>