@{
    ViewData["Title"] = "Yönetici Özeti";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary fw-bold">
        <i class="bi bi-speedometer2"></i> Dashboard (Yönetici Özeti)
    </h2>

    <!-- Üst Kısım: Özet Kartları -->
    <div class="row">
        <!-- Toplam Fatura Kartı (Mavi) -->
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-primary shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase text-white-50 fw-bold">Kayıtlı Fatura Sayısı</h6>
                            <h2 class="mb-0 fw-bold">@ViewBag.ToplamFatura <span class="fs-6 fw-normal">Adet</span></h2>
                        </div>
                        <i class="bi bi-receipt fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link text-decoration-none" href="/Faturalar">Tüm Faturaları Gör</a>
                    <div class="small text-white"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        </div>

        <!-- Ödenen Tutar Kartı (Yeşil) -->
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-success shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase text-white-50 fw-bold">Toplam Ödenen Tutar</h6>
                            <h2 class="mb-0 fw-bold">@ViewBag.ToplamOdendi.ToString("N2") ₺</h2>
                        </div>
                        <i class="bi bi-cash-stack fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link text-decoration-none" href="/Faturalar">Detayları Gör</a>
                    <div class="small text-white"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        </div>

        <!-- Bekleyen (Ödenmeyen) Borç Kartı (Kırmızı) -->
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-danger shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase text-white-50 fw-bold">Bekleyen Ödemeler</h6>
                            <h2 class="mb-0 fw-bold">@ViewBag.ToplamOdenmedi.ToString("N2") ₺</h2>
                        </div>
                        <i class="bi bi-exclamation-octagon fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link text-decoration-none" href="/Faturalar">Detayları Gör</a>
                    <div class="small text-white"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alt Kısım: Grafikler -->
    <div class="row mt-2">
        <!-- Halka Grafiği (Tutar Dağılımı) -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-secondary"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Tutar Dağılımı (₺)</h5>
                </div>
                <div class="card-body d-flex justify-content-center">
                    <div style="width: 70%;">
                        <canvas id="tutarGrafik"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sütun Grafiği (Adet Dağılımı) -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-secondary"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Fatura Durumları (Adet)</h5>
                </div>
                <div class="card-body">
                    <canvas id="adetGrafik"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Kütüphanesi ve JavaScript Kodlarımız -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // C#'tan gelen verileri (virgül hatası olmaması için) güvenli bir şekilde JS'e alıyoruz
        const odenenTutar = @Json.Serialize(ViewBag.ToplamOdendi);
        const bekleyenTutar = @Json.Serialize(ViewBag.ToplamOdenmedi);
        const odenenAdet = @ViewBag.OdenenAdet;
        const bekleyenAdet = @ViewBag.BekleyenAdet;

        // 1. Tutar Halka Grafiği (Doughnut)
        const ctxTutar = document.getElementById('tutarGrafik').getContext('2d');
        new Chart(ctxTutar, {
            type: 'doughnut',
            data: {
                labels: ['Ödenen (₺)', 'Bekleyen (₺)'],
                datasets: [{
                    data: [odenenTutar, bekleyenTutar],
                    backgroundColor: ['#198754', '#dc3545'], // Bootstrap Success ve Danger renkleri
                    hoverOffset: 10
                }]
            },
            options: {
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // 2. Adet Sütun Grafiği (Bar)
        const ctxAdet = document.getElementById('adetGrafik').getContext('2d');
        new Chart(ctxAdet, {
            type: 'bar',
            data: {
                labels: ['Ödenen', 'Bekleyen'],
                datasets: [{
                    label: 'Fatura Adedi',
                    data: [odenenAdet, bekleyenAdet],
                    backgroundColor: ['#198754', '#dc3545'],
                    borderRadius: 5
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 } // Küsüratlı fatura adedi olmaz :)
                    }
                },
                plugins: {
                    legend: { display: false } // Sütun grafiğinde alttaki açıklamaya gerek yok
                }
            }
        });
    </script>
}