@model IEnumerable<FaturaGiderSistemi.Models.Fatura>
@{
    ViewData["Title"] = "Ana Sayfa - Dashboard";
}

<!-- İkonlar için -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid mt-4">
    <h2 class="fw-bold mb-4 text-secondary"><i class="bi bi-speedometer2"></i> Sistem Özeti</h2>

    <!-- İSTATİSTİK KARTLARI -->
    <div class="row g-4 mb-4">
        <!-- Kayıtlı Şirket Kartı -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-buildings"></i></div>
                    <div>
                        <h6 class="text-uppercase mb-1 fw-bold opacity-75">Kayıtlı Şirket</h6>
                        <h3 class="mb-0 fw-bold">@ViewBag.ToplamSirket</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toplam Fatura Kartı -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-info text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-receipt"></i></div>
                    <div>
                        <h6 class="text-uppercase mb-1 fw-bold opacity-75">Toplam Fatura</h6>
                        <h3 class="mb-0 fw-bold">@ViewBag.ToplamFatura <span class="fs-6 opacity-75">Adet</span></h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ödenen Tutar Kartı -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <h6 class="text-uppercase mb-1 fw-bold opacity-75">Ödenen Tutar</h6>
                        <h3 class="mb-0 fw-bold">@ViewBag.ToplamOdendi.ToString("N2") ₺</h3>
                        <small class="opacity-75">(@ViewBag.OdenenAdet Adet)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bekleyen Tutar Kartı -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-danger text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <h6 class="text-uppercase mb-1 fw-bold opacity-75">Bekleyen Tutar</h6>
                        <h3 class="mb-0 fw-bold">@ViewBag.ToplamOdenmedi.ToString("N2") ₺</h3>
                        <small class="opacity-75">(@ViewBag.BekleyenAdet Adet)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SON İŞLEMLER TABLOSU -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-secondary"><i class="bi bi-list-stars"></i> Son Eklenen 5 Fatura</h5>
            <a asp-controller="Faturalar" asp-action="Index" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Şirket</th>
                            <th>Tarih</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@(item.Sirket != null ? item.Sirket.Ad : "Bilinmiyor")</td>
                                    <td>@item.Tarih.ToString("dd.MM.yyyy")</td>
                                    <td class="fw-bold">@item.Tutar.ToString("N2") ₺</td>
                                    <td>
                                        @if (item.Durum)
                                        {
                                            <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle"></i> Ödendi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-2 py-1"><i class="bi bi-clock"></i> Bekliyor</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Henüz sisteme fatura eklenmemiş.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>