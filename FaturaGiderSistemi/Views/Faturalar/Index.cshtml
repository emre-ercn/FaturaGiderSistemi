@model IEnumerable<FaturaGiderSistemi.Models.Fatura>

@{
    ViewData["Title"] = "Faturalar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Faturalar</h2>
    <a asp-action="Create" class="btn btn-success">Yeni Fatura Ekle</a>
</div>

<!-- ARAMA VE FİLTRELEME ÇUBUĞU -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-controller="Faturalar" asp-action="Index" method="get">
            <div class="row g-3">

                <!-- Arama Kutusu -->
                <div class="col-md-5">
                    <input type="text" name="aramaKelimesi" value="@ViewBag.AramaKelimesi" class="form-control" placeholder="Fatura No ile ara...">
                </div>

                <!-- Durum Filtresi (Dropdown) -->
                <div class="col-md-4">
                    <select name="durumFiltresi" class="form-select">
                        <option value="">Tüm Faturalar</option>
                        <option value="1" selected="@(ViewBag.DurumFiltresi == "1" ? "selected" : null)">Sadece Ödenenler</option>
                        <option value="0" selected="@(ViewBag.DurumFiltresi == "0" ? "selected" : null)">Sadece Bekleyenler</option>
                    </select>
                </div>

                <!-- Butonlar -->
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Filtrele
                    </button>
                    <a asp-action="Index" class="btn btn-secondary w-50">Temizle</a>
                </div>

            </div>
        </form>
    </div>
</div>

<!-- EXCEL'E AKTAR BUTONU -->
<div class="d-flex justify-content-end mb-2">
    <a asp-controller="Faturalar" asp-action="FaturalariExcelIndir" class="btn btn-success">
        <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
    </a>
</div>

<!-- FATURALAR TABLOSU -->
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Fatura No</th>
                <th>Şirket</th>
                <th>Tutar</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Arama kriterlerine uygun fatura bulunamadı.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle">@item.FaturaNo</td>
                        <td class="align-middle">@(item.Sirket != null ? item.Sirket.Ad : "Bilinmiyor")</td>
                        <td class="align-middle">@item.ToplamTutar.ToString("C2")</td>
                        <td class="align-middle">
                            @if (item.Durum)
                            {
                                <span class="badge bg-success">Ödendi</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Bekliyor</span>
                            }
                        </td>
                        <td class="align-middle">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>