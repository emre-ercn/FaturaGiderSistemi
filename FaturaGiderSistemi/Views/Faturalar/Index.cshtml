@model IEnumerable<FaturaGiderSistemi.Models.Fatura>

@{
    ViewData["Title"] = "Faturalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Fatura Listesi</h2>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm me-2">Yeni Fatura Ekle</a>
        <a asp-action="ExcelaAktar" class="btn btn-success shadow-sm">
            Excel'e Aktar
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Fatura No</th>
                        <th>Fiş No</th>
                        <th>Şirket</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th class="text-end pe-3">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 align-middle">@item.FaturaNo</td>
                                <td class="align-middle">@item.FisNo</td>
                                <td class="align-middle">@(item.Sirket != null ? item.Sirket.Ad : "-")</td>
                                <td class="align-middle">
                                    <!-- İŞTE BURASI DEĞİŞTİ: item.Durum kullanıyoruz -->
                                    @if (item.Durum)
                                    {
                                        <span class="badge bg-success">Ödendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Bekliyor</span>
                                    }
                                </td>
                                <td class="align-middle">@item.Tarih.ToString("dd.MM.yyyy")</td>
                                <td class="text-end pe-3 align-middle">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detay</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Henüz kayıtlı fatura bulunmuyor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>