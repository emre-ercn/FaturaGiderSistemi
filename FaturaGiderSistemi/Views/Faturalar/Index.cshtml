@model IEnumerable<FaturaGiderSistemi.Models.Fatura>

@{
    ViewData["Title"] = "Faturalar";
}

<!-- 1. İKONLARIN GÖRÜNMESİ İÇİN BOOTSTRAP ICONS CDN EKLENDİ -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <!-- Üst Başlık ve Yeni Ekle / Excel Butonları -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-receipt"></i> Fatura Listesi
        </h2>
        <div>
            <!-- EXCEL BUTONU BURAYA EKLENDİ (Controller'daki ExcelaAktar metoduna gidiyor) -->
            <a asp-action="ExcelaAktar" class="btn btn-outline-success shadow-sm me-2" title="Excel'e Aktar">
                <i class="bi bi-file-earmark-excel"></i> Excel İndir
            </a>
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-lg"></i> Yeni Fatura Ekle
            </a>
        </div>
    </div>

    <!-- Arama ve Filtreleme Formu (Gün 26) -->
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body">
            <form asp-controller="Faturalar" asp-action="Index" method="get">
                <div class="row g-3 align-items-center">

                    <!-- Şirket Adı Arama -->
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="aramaKelimesi" value="@ViewBag.AramaKelimesi" class="form-control" placeholder="Şirket adına göre ara...">
                        </div>
                    </div>

                    <!-- Durum Filtresi -->
                    <div class="col-md-4">
                        <select name="durumFiltresi" class="form-select">
                            <option value="">Tüm Durumlar</option>

                            @if (ViewBag.DurumFiltresi == true)
                            {
                                <option value="true" selected>Ödenenler</option>
                            }
                            else
                            {
                                <option value="true">Ödenenler</option>
                            }

                            @if (ViewBag.DurumFiltresi == false)
                            {
                                <option value="false" selected>Bekleyenler</option>
                            }
                            else
                            {
                                <option value="false">Bekleyenler</option>
                            }
                        </select>
                    </div>

                    <!-- Butonlar -->
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel"></i> Filtrele
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-50" title="Filtreleri Temizle">
                            <i class="bi bi-x-circle"></i> Temizle
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Fatura Tablosu -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Şirket Adı</th>
                            <th>Tarih</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="align-middle">
                                    <td class="fw-bold">@(item.Sirket != null ? item.Sirket.Ad : "Şirket Yok")</td>
                                    <td>@item.Tarih.ToString("dd.MM.yyyy")</td>
                                    <td>@item.Tutar.ToString("N2") ₺</td>
                                    <td>
                                        @if (item.Durum)
                                        {
                                            <span class="badge bg-success px-2 py-2"><i class="bi bi-check-circle"></i> Ödendi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-2 py-2"><i class="bi bi-x-circle"></i> Bekliyor</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detay">
                                            <i class="bi bi-info-circle"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" class="delete-form">
                                            <button type="button" class="btn btn-sm btn-outline-danger delete-btn" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                        <a asp-action="FaturaPdfIndir" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1" title="PDF'e Aktar">
                                            <i class="bi bi-file-earmark-pdf"></i> PDF
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-search fs-3 d-block mb-2"></i>
                                    Filtrelere uygun veya kayıtlı fatura bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- SWEETALERT2 EKLENDİ -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function () {
                const form = this.closest('.delete-form');

                Swal.fire({
                    title: 'Emin misin?',
                    text: "Bu faturayı silmek istediğine emin misin? Bu işlem geri alınamaz!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}