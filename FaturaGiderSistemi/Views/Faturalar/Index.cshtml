@model IEnumerable<FaturaGiderSistemi.Models.Fatura>
<!-- Kendi model yolunu projene göre düzeltmeyi unutma -->
@{
    ViewData["Title"] = "Faturalar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Faturalar Listesi</h2>

        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Yeni Fatura Ekle
            </a>
            <!-- 22. GÜN: EXCEL'E AKTAR BUTONU -->
            <a asp-action="ExcelaAktar" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
            </a>
        </div>
    </div>

    <table class="table table-striped table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Fatura ID</th>
                <th>Şirket Adı</th>
                <th>Tarih</th>
                <th>Tutar</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="align-middle">@item.Id</td>
                    <td class="align-middle">@item.Sirket?.Ad</td>
                    <td class="align-middle">@item.Tarih.ToString("dd.MM.yyyy")</td>
                    <td class="align-middle fw-bold text-success">@item.Tutar.ToString("N2") ₺</td>
                    <td class="align-middle">
                        @if (item.Durum)
                        {
                            <span class="badge bg-success">Ödendi</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Ödenmedi</span>
                        }
                    </td>
                    <td class="align-middle">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Sil</a>

                        <!-- 23. GÜN: PDF'E AKTAR BUTONU -->
                        <a asp-action="FaturaPdfIndir" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            <i class="bi bi-file-earmark-pdf"></i> PDF'e Aktar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>